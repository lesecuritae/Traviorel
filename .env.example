# Optional. Traviorel erzeugt standardmäßig selbst einen internen Token.
# Nur setzen, wenn bewusst ein eigener Token verwendet werden soll.
DB_CFFI_TOKEN=
OPENCELLID_API_KEY=
OPENCELLID_CSV_PATH=
OPENCELLID_SEARCH_RADIUS_KM=5
NINA_API_URL=https://warnung.bund.de/api31
NINA_TIMEOUT=12
NINA_CACHE_TTL=300

# Sicherer Default: nur lokal erreichbar. Für LAN-Zugriff bewusst auf 0.0.0.0 setzen.
TRAVIOREL_BIND_HOST=127.0.0.1
TRAVIOREL_PORT=8791

# Historische Bahn-Zuverlässigkeit (optional vollständig abschaltbar).
HISTORY_ENABLED=true
HISTORY_CACHE_DIR=/var/lib/reisevergleich/history
HISTORY_CACHE_MAX_GB=5
HISTORY_REMOTE_TIMEOUT=60
HISTORY_MAX_CONCURRENCY=2
HISTORY_STATS_TTL=86400
HISTORY_DEFAULT_WINDOW_DAYS=90
SEARCH_DEPARTURE_TOLERANCE_MINUTES=15
